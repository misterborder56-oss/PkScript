---------------------------------------------------------------
local function crearFilaSimple(nombre, orden, padre)
	local b = crearBoton(nombre, padre, UDim2.new(1, -10, 0, 40))
	b.LayoutOrder = orden
	pintar(b, false)
	return b
end

-- Botón + [-] valor [+]
local function crearFilaConValor(nombre, orden, padre, clave, paso, minimo, maximo, alCambiar)
	local fila = Instance.new("Frame")
	fila.Size = UDim2.new(1, -10, 0, 40)
	fila.BackgroundTransparency = 1
	fila.LayoutOrder = orden
	fila.Parent = padre

	local toggle = crearBoton(nombre, fila, UDim2.new(1, -138, 1, 0))
	pintar(toggle, false)

	local menos = crearBoton("-", fila, UDim2.new(0, 36, 1, 0), UDim2.new(1, -130, 0, 0))

	local etiqueta = Instance.new("TextLabel")
	etiqueta.Size = UDim2.new(0, 52, 1, 0)
	etiqueta.Position = UDim2.new(1, -92, 0, 0)
	etiqueta.BackgroundTransparency = 1
	etiqueta.Text = tostring(valores[clave])
	etiqueta.TextColor3 = BLANCO
	etiqueta.Font = Enum.Font.GothamBold
	etiqueta.TextSize = 18
	etiqueta.Parent = fila

	local mas = crearBoton("+", fila, UDim2.new(0, 38, 1, 0), UDim2.new(1, -38, 0, 0))

	menos.MouseButton1Click:Connect(function()
		valores[clave] = math.clamp(valores[clave] - paso, minimo, maximo)
		etiqueta.Text = tostring(valores[clave])
		alCambiar()
	end)

	mas.MouseButton1Click:Connect(function()
		valores[clave] = math.clamp(valores[clave] + paso, minimo, maximo)
		etiqueta.Text = tostring(valores[clave])
		alCambiar()
	end)

	return toggle
end

