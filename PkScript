tituloTP.TextSize = 16
tituloTP.Parent = paginaMas

local botonesJugadores = {}

local function actualizarJugadores(saliendo)
	for _, b in ipairs(botonesJugadores) do
		b:Destroy()
	end
	table.clear(botonesJugadores)

	local orden = 11
	for _, otro in ipairs(Players:GetPlayers()) do
		if otro ~= player and otro ~= saliendo then
			local b = crearBoton(otro.Name, paginaMas, UDim2.new(1, -10, 0, 32))
			b.LayoutOrder = orden
			orden += 1

			b.MouseButton1Click:Connect(function()
				local miHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				local suHRP = otro.Character and otro.Character:FindFirstChild("HumanoidRootPart")
				if miHRP and suHRP then
					miHRP.CFrame = suHRP.CFrame * CFrame.new(0, 0, 3)
				end
			end)

			table.insert(botonesJugadores, b)
		end
	end
end

actualizarJugadores()
Players.PlayerAdded:Connect(function() actualizarJugadores() end)
Players.PlayerRemoving:Connect(actualizarJugadores)

