-- HUMANOID (salto y velocidad al caminar)
---------------------------------------------------------------
local function obtenerHumanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function aplicarHumanoid()
	local h = obtenerHumanoid()
	if not h then return end
	h.UseJumpPower = true
	h.JumpPower = estado.saltoAlto and valores.salto or SALTO_NORMAL
	h.WalkSpeed = estado.velocidad and valores.caminar or CAMINAR_NORMAL
end

