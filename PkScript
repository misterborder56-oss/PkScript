local paginas = {}
local pestanas = {}

local function mostrarPagina(nombre)
	for n, pagina in pairs(paginas) do
		pagina.Visible = (n == nombre)
	end
	for n, boton in pairs(pestanas) do
		local activa = (n == nombre)
		boton.BackgroundColor3 = activa and COLOR_TAB or COLOR_BOTON
		local borde = boton:FindFirstChildOfClass("UIStroke")
		if borde then
			borde.Color = activa and ROJO or COLOR_BORDE
		end
	end
end

local function crearSeccion(nombre, orden)
	local boton = crearBoton(nombre, barraLateral, UDim2.new(1, 0, 0, 36))
	boton.LayoutOrder = orden

	local pagina = Instance.new("ScrollingFrame")
	pagina.Size = UDim2.new(1, -128, 1, -56)
	pagina.Position = UDim2.new(0, 120, 0, 48)
	pagina.BackgroundTransparency = 1
	pagina.BorderSizePixel = 0
	pagina.ScrollBarThickness = 4
	pagina.ScrollBarImageColor3 = ROJO
	pagina.CanvasSize = UDim2.new(0, 0, 0, 0)
	pagina.AutomaticCanvasSize = Enum.AutomaticSize.Y
	pagina.Visible = false
	pagina.Parent = frame

	local lista = Instance.new("UIListLayout")
	lista.Padding = UDim.new(0, 6)
	lista.SortOrder = Enum.SortOrder.LayoutOrder
	lista.Parent = pagina

	paginas[nombre] = pagina
	pestanas[nombre] = boton

	boton.MouseButton1Click:Connect(function()
		mostrarPagina(nombre)
	end)

	return pagina
end

