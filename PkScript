---------------------------------------------------------------
-- FUNCIONES AYUDANTES DE ESTILO
---------------------------------------------------------------
local function redondear(objeto, radio)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radio)
	c.Parent = objeto
end

local function crearBoton(texto, padre, tamano, posicion)
	local b = Instance.new("TextButton")
	b.Size = tamano
	if posicion then b.Position = posicion end
	b.Text = texto
	b.TextColor3 = BLANCO
	b.BackgroundColor3 = COLOR_BOTON
	b.BorderSizePixel = 0
	b.Font = Enum.Font.GothamBold
	b.TextSize = 16
	b.Parent = padre
	redondear(b, 8)

	local borde = Instance.new("UIStroke")
	borde.Thickness = 2
	borde.Color = COLOR_BORDE
	borde.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	borde.Parent = b

	return b
end

-- Rojo = apagado, verde = encendido
local function pintar(boton, activo)
	local borde = boton:FindFirstChildOfClass("UIStroke")
	if borde then
		borde.Color = activo and VERDE or ROJO
	end
	boton.BackgroundColor3 = activo and COLOR_ACTIVO or COLOR_BOTON
end

