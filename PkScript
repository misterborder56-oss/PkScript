--------------------------------------------------------------------

local function crearBotonPequeno(texto, posicion, padre)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0, 30, 0, 26)
	b.Position = posicion
	b.BackgroundColor3 = COLOR_BARRA
	b.Text = texto
	b.TextColor3 = COLOR_TEXTO
	b.Font = Enum.Font.GothamBold
	b.TextSize = 16
	b.Parent = padre
	redondear(b, 8)
	return b
end

for i, opcion in ipairs(opciones) do

	local fila = Instance.new("Frame")
	fila.Size = UDim2.new(1, 0, 0, 40)
	fila.BackgroundColor3 = COLOR_FILA
	fila.BorderSizePixel = 0
	fila.LayoutOrder = i
	fila.Parent = lista

	redondear(fila, 8)

	local texto = Instance.new("TextLabel")
	texto.Size = UDim2.new(1, -110, 1, 0)
	texto.Position = UDim2.new(0, 12, 0, 0)
	texto.BackgroundTransparency = 1
	texto.Text = opcion.nombre
	texto.TextColor3 = COLOR_TEXTO
	texto.Font = Enum.Font.GothamMedium
	texto.TextSize = 14
	texto.TextXAlignment = Enum.TextXAlignment.Left
	texto.Parent = fila

	if opcion.tipo == "interruptor" then

		local activado = false
		estados[opcion.nombre] = false
		texto.Size = UDim2.new(1, -70, 1, 0)

		local interruptor = Instance.new("TextButton")
		interruptor.Size = UDim2.new(0, 44, 0, 22)
		interruptor.Position = UDim2.new(1, -56, 0.5, -11)
		interruptor.BackgroundColor3 = COLOR_OFF
		interruptor.Text = ""
		interruptor.AutoButtonColor = false
		interruptor.Parent = fila

		redondear(interruptor, 11)

		local bolita = Instance.new("Frame")
		bolita.Size = UDim2.new(0, 18, 0, 18)
		bolita.Position = UDim2.new(0, 2, 0.5, -9)
		bolita.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		bolita.BorderSizePixel = 0
		bolita.Parent = interruptor

		redondear(bolita, 9)

		interruptor.MouseButton1Click:Connect(function()
			activado = not activado
			estados[opcion.nombre] = activado

			TweenService:Create(interruptor, infoTween, {
				BackgroundColor3 = activado and COLOR_ON or COLOR_OFF
			}):Play()

			TweenService:Create(bolita, infoTween, {
				Position = activado
					and UDim2.new(1, -20, 0.5, -9)
					or UDim2.new(0, 2, 0.5, -9)
			}):Play()

			opcion.alCambiar(activado)
		end)

	else -- tipo "numero"

		local function refrescar()
			texto.Text = opcion.nombre .. ": " .. ajustes[opcion.clave]
		end
		refrescar()

		local menos = crearBotonPequeno("-", UDim2.new(1, -78, 0.5, -13), fila)
		local mas = crearBotonPequeno("+", UDim2.new(1, -42, 0.5, -13), fila)

		local function cambiar(delta)
			ajustes[opcion.clave] = math.clamp(
				ajustes[opcion.clave] + delta,
				opcion.min,
				opcion.max
			)
			refrescar()
			if opcion.alAjustar then
				opcion.alAjustar()
			end
		end

		menos.MouseButton1Click:Connect(function() cambiar(-opcion.paso) end)
		mas.MouseButton1Click:Connect(function() cambiar(opcion.paso) end)
	end
end

--------------------------------------------------------------------
-- REAPLICAR AL REAPARECER
--------------------------------------------------------------------

player.CharacterAdded:Connect(function()
	task.wait(0.5)

	velocidadOriginal = nil
	saltoOriginal = nil
	table.clear(colisionesOriginales)

	for _, opcion in ipairs(opciones) do
		if opcion.tipo == "interruptor" and estados[opcion.nombre] then
			opcion.alCambiar(true)
		end
	end
end)

--------------------------------------------------------------------
-- ARRASTRAR PANEL
--------------------------------------------------------------------

local arrastrando = false
local inicioMouse
local inicioPanel

barra.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		arrastrando = true
		inicioMouse = input.Position
		inicioPanel = panel.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if arrastrando and (
		input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
	) then

		local delta = input.Position - inicioMouse

		panel.Position = UDim2.new(
			inicioPanel.X.Scale,
			inicioPanel.X.Offset + delta.X,
			inicioPanel.Y.Scale,
			inicioPanel.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		arrastrando = false
	end
end)

