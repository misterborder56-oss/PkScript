--------------------------------------------------------------------
-- PERSONAJE
--------------------------------------------------------------------

local personaje
local humanoid
local root

local function actualizarPersonaje(char)
	personaje = char
	humanoid = char:WaitForChild("Humanoid")
	root = char:WaitForChild("HumanoidRootPart")
end

if player.Character then
	actualizarPersonaje(player.Character)
end

player.CharacterAdded:Connect(actualizarPersonaje)

local function obtenerPersonaje()
	if not personaje or not personaje.Parent then
		actualizarPersonaje(player.Character or player.CharacterAdded:Wait())
	end

	humanoid = personaje:WaitForChild("Humanoid")
	root = personaje:WaitForChild("HumanoidRootPart")

	return humanoid, root
end

--------------------------------------------------------------------
-- 1. TRASPASAR PAREDES
--------------------------------------------------------------------

local conexionesNoclip
local colisionesOriginales = {}

local function Noclip(activar)
	if conexionesNoclip then
		conexionesNoclip:Disconnect()
		conexionesNoclip = nil
	end

	if activar then
		conexionesNoclip = RunService.Stepped:Connect(function()
			if not personaje then return end

			for _, objeto in ipairs(personaje:GetDescendants()) do
				if objeto:IsA("BasePart") then
					if colisionesOriginales[objeto] == nil then
						colisionesOriginales[objeto] = objeto.CanCollide
					end
					objeto.CanCollide = false
				end
			end
		end)
	else
		for objeto, valor in pairs(colisionesOriginales) do
			if objeto.Parent then
				objeto.CanCollide = valor
			end
		end
		table.clear(colisionesOriginales)
	end
end

--------------------------------------------------------------------
-- 2. VOLAR
--------------------------------------------------------------------

local vueloConnection
local bodyVelocity
local bodyGyro

local function Volar(activar)
	if vueloConnection then
		vueloConnection:Disconnect()
		vueloConnection = nil
	end

	if bodyVelocity then
		bodyVelocity:Destroy()
		bodyVelocity = nil
	end

	if bodyGyro then
		bodyGyro:Destroy()
		bodyGyro = nil
	end

	if not activar then
		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
		return
	end

	local hum, hrp = obtenerPersonaje()

	hum:ChangeState(Enum.HumanoidStateType.Physics)

	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.MaxForce = Vector3.new(100000, 100000, 100000)
	bodyVelocity.Velocity = Vector3.zero
	bodyVelocity.Parent = hrp

	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.MaxTorque = Vector3.new(100000, 100000, 100000)
	bodyGyro.P = 10000
	bodyGyro.Parent = hrp

	vueloConnection = RunService.RenderStepped:Connect(function()
		if not root or not root.Parent then return end

		local camara = workspace.CurrentCamera
		if not camara then return end

		local direccion = Vector3.zero

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			direccion += camara.CFrame.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			direccion -= camara.CFrame.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			direccion += camara.CFrame.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			direccion -= camara.CFrame.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			direccion += Vector3.yAxis
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			direccion -= Vector3.yAxis
		end

		if direccion.Magnitude > 0 then
			bodyVelocity.Velocity = direccion.Unit * ajustes.vuelo
		else
			bodyVelocity.Velocity = Vector3.zero
		end

		bodyGyro.CFrame = camara.CFrame
	end)
end

--------------------------------------------------------------------
-- 3. SALTO AUMENTADO
--------------------------------------------------------------------

local saltoOriginal

local function Salto(activar)
	local hum = obtenerPersonaje()

	if activar then
		if saltoOriginal == nil then
			saltoOriginal = hum.JumpPower
		end
		hum.UseJumpPower = true
		hum.JumpPower = ajustes.salto
	else
		if saltoOriginal then
			hum.JumpPower = saltoOriginal
			saltoOriginal = nil
		end
	end
end

--------------------------------------------------------------------
-- 4. VELOCIDAD AUMENTADA
--------------------------------------------------------------------

local velocidadOriginal

local function Velocidad(activar)
	local hum = obtenerPersonaje()

	if activar then
		if velocidadOriginal == nil then
			velocidadOriginal = hum.WalkSpeed
		end
		hum.WalkSpeed = ajustes.velocidad
	else
		if velocidadOriginal then
			hum.WalkSpeed = velocidadOriginal
			velocidadOriginal = nil
		end
	end
end

--------------------------------------------------------------------
-- 5. SALTO INFINITO
--------------------------------------------------------------------

local saltoInfinitoConn

local function SaltoInfinito(activar)
	if saltoInfinitoConn then
		saltoInfinitoConn:Disconnect()
		saltoInfinitoConn = nil
	end

	if activar then
		saltoInfinitoConn = UserInputService.JumpRequest:Connect(function()
			if humanoid then
				humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end)
	end
end

--------------------------------------------------------------------
-- 6. GRAVEDAD BAJA
--------------------------------------------------------------------

local function Gravedad(activar)
	workspace.Gravity = activar and GRAVEDAD_BAJA or gravedadOriginal
end

