---------------------------------------------------------------
-- TRASPASAR OBJETOS (NOCLIP)
---------------------------------------------------------------
local conexionNoclip

local function setNoclip(activo)
	estado.noclip = activo
	pintar(noclipBtn, activo)

	if conexionNoclip then
		conexionNoclip:Disconnect()
		conexionNoclip = nil
	end

	if activo then
		conexionNoclip = RunService.Stepped:Connect(function()
			local char = player.Character
			if not char then return end
			for _, parte in ipairs(char:GetDescendants()) do
				if parte:IsA("BasePart") then
					parte.CanCollide = false
				end
			end
		end)
	end
end

noclipBtn.MouseButton1Click:Connect(function()
	setNoclip(not estado.noclip)
end)

